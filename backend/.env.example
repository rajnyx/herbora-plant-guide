# Herbora Backend Environment Configuration Example

PORT=5000
FLASK_ENV=development

# Database Connection URL
# For local SQLite development (default):
DATABASE_URL=sqlite:///herbora.db
# For remote Supabase PostgreSQL:
# DATABASE_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.jjibhdlrzpahjefislrj.supabase.co:5432/postgres

# Supabase Credentials (optional for SQLite, required for PostgreSQL & Auth)
SUPABASE_URL=https://jjibhdlrzpahjefislrj.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Pl@ntNet API Key for Botanical Vision (optional)
PLANTNET_API_KEY=your_plantnet_api_key_here

# Feedback Email Notification Settings
FEEDBACK_RECIPIENT_EMAIL=rajsingh2007.rs@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Optional: Gmail address & 16-character Google App Password for live SMTP sending
SMTP_USER=
SMTP_PASSWORD=
