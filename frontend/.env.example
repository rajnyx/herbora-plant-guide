# Herbora Frontend Environment Variables
# Connects directly to Supabase Auth & Storage via client-side SDK
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key

# Botanical Vision API Key (Optional)
VITE_PLANTNET_API_KEY=your_plantnet_api_key
