# Herbora Environment Configuration Example

# Backend Server & Database
PORT=5000
FLASK_ENV=development

# Database Connection URL
# For local SQLite development (default, no cloud setup needed):
DATABASE_URL=sqlite:///herbora.db
# For remote Supabase PostgreSQL:
# DATABASE_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Auth & Cloud Database Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Pl@ntNet API for Botanical Vision Image Recognition (optional)
PLANTNET_API_KEY=your_plantnet_api_key_here
VITE_PLANTNET_API_KEY=your_plantnet_api_key_here

# Feedback Email Notification Settings
FEEDBACK_RECIPIENT_EMAIL=rajsingh2007.rs@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Optional: Gmail address & 16-character Google App Password for live SMTP sending
SMTP_USER=
SMTP_PASSWORD=
